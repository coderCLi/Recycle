# aiRecycle 配置清单
# 上线前必须填写的值

# aiRecycle 配置清单
# 上线前必须填写的值

# 百度AI - 在 https://console.bce.baidu.com/ai 创建应用获取
# 配置方式：微信云开发控制台 > 云函数 > baidu-ai-recognize > 编辑 > 环境变量
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 微信订阅消息模板ID - 在微信公众平台 > 订阅消息 创建
WX_TMPL_RECYCLER_DEPARTURE=    # 回收员出发通知
WX_TMPL_ORDER_COMPLETE=         # 订单完成通知
WX_TMPL_ADMIN_NOTIFY=           # 管理员通知
WX_TMPL_DORMANT_WAKE=           # 沉默用户唤醒

# 管理员 openId - 微信云开发控制台 > 用户管理 查看
ADMIN_OPENID=
