{
	"lazyCodeLoading": "requiredComponents",
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTitleText": "回收",
		"navigationBarBackgroundColor": "#f8f8f8",
		"navigationBarTextStyle": "black",
		"backgroundColor": "#FFFFFF"
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
			"^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"tabBar": {
		"color": "#090000",
		"selectedColor": "#FC950E",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "black",
		"height": "50px",
		"fontSize": "10px",
		"iconWidth": "24px",
		"spacing": "3px",
		"list": [
			{
				"iconPath": "static/images/tabBar/home_tabbar_icon_home_normal_img.png",
				"selectedIconPath": "static/images/tabBar/home_tabbar_icon_home_active_img.png",
				"pagePath": "pages/home/home",
				"text": "首页"
			},
			{
				"iconPath": "static/images/tabBar/home_tabbar_icon_mine_normal_img.png",
				"selectedIconPath": "static/images/tabBar/home_tabbar_icon_mine_active_img.png",
				"pagePath": "pages/mine/mine",
				"text": "我的"
			}
		]
	},
	"subPackages": [
		{
			"root": "package-address",
			"pages": [
				{
					"path": "pages/addressList",
					"style": {
						"navigationBarTitleText": "选择地址"
					}
				},
				{
					"path": "pages/addAddress",
					"style": {
						"navigationBarTitleText": "添加地址"
					}
				},
				{
					"path": "pages/editorAddress",
					"style": {
						"navigationBarTitleText": "编辑地址"
					}
				}
			]
		}
	],
	"pages": [
		{
			"path": "pages/launch/launch",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": ""
			}
		},
		{
			"path": "pages/home/home",
			"style": {
				"navigationBarTitleText": "富区回收",
				"navigationBarButtonType": "",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/estimate/estimate",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "在线估价"
			}
		},
		{
			"path": "pages/appointment/appointment",
			"style": {
				"navigationBarTitleText": "预约上门",
				"disableScroll": true
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationBarButtonType": ""
			}
		},
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录"
			},
			"statusBar": false,
			"navigationBar": false
		},
		{
			"path": "pages/password/set",
			"style": {
				"navigationBarTitleText": "设置密码"
			},
			"statusBar": false
		},
		{
			"path": "pages/password/update",
			"style": {
				"navigationBarTitleText": "修改密码",
				"disableScroll": true
			},
			"statusBar": false,
			"navigationBar": false
		},
		{
			"path": "pages/phone/verify",
			"style": {
				"navigationBarTitleText": "验证手机号",
				"disableScroll": true
			},
			"statusBar": false,
			"navigationBar": false
		},
		{
			"path": "pages/phone/bind",
			"style": {
				"navigationBarTitleText": "绑定手机号",
				"disableScroll": true
			},
			"statusBar": false,
			"navigationBar": false
		},
		{
			"path": "pages/about/about",
			"style": {
				"navigationBarTitleText": "关于"
			}
		},
		{
			"path": "pages/feedback/feedback",
			"style": {
				"navigationBarTitleText": "意见反馈"
			}
		},
		{
			"path": "pages/feedback/feedHistory",
			"style": {
				"navigationBarTitleText": "反馈历史"
			}
		},
		{
			"path": "pages/identity-auth/identity-auth",
			"style": {
				"navigationBarTitleText": "实名认证"
			}
		},
		{
			"path": "pages/identity-auth/renzheng-auth",
			"style": {
				"navigationBarTitleText": "实名认证"
			}
		},
		{
			"path": "pages/setting/setting",
			"style": {
				"navigationBarTitleText": "设置"
			},
			"navigationBar": false
		},
		{
			"path": "pages/personInfo/personInfo",
			"style": {
				"navigationBarTitleText": "个人资料"
			},
			"navigationBar": false
		},
		{
			"path": "pages/admin/appointments",
			"style": {
				"navigationBarTitleText": "预约管理"
			}
		},
		{
			"path": "pages/admin/appointmentDetail",
			"style": {
				"navigationBarTitleText": "预约详情"
			}
		},
		{
			"path": "pages/admin/categories",
			"style": {
				"navigationBarTitleText": "分类管理"
			}
		}
	]
}
